<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_drive</name>
  <version>0.0.0</version>
  <description>オムニホイール(3 輪 / 4 輪)の足回り: /cmd_vel → 各ホイールの速さ、オドメトリ</description>
  <maintainer email="e2527@matsue-ct.ac.jp">E2527</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>stm_bridge</exec_depend>
  <!-- 操縦(WASD・ゲームパッド)は swerve_drive のものを使う -->
  <exec_depend>swerve_drive</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
